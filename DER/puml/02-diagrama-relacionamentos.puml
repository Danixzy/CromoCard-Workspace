@startuml 02_Diagrama_de_Relacionamentos
' =====================================================================
'  CromoCard - Sistema de Gestao de Cartas Colecionaveis
'  2/3 - DIAGRAMA DE RELACIONAMENTOS  (entidades + cardinalidades)
'
'  DECISOES DE LAYOUT (testadas renderizando 4 variantes):
'  1) "left to right direction" -> o desenho fica em RETRATO
'     (~1900 x 3100) em vez de uma tira de 4500 x 1350. A tira nao
'     cabia legivel na pagina e ainda estourava o limite de 4096px
'     do servidor, cortando entidades do lado direito.
'  2) SEM caixas de "package": a entidade "usuario" se liga a 25 das
'     76 relacoes. Com caixas, o layout tem de cruzar todas elas e o
'     desenho vira um emaranhado. Aqui o modulo e indicado pela COR
'     de fundo da entidade (ver legenda).
'  3) Rotulos apenas onde ha mais de uma ligacao entre o mesmo par.
'
'  Somente chaves (PK/FK). Os atributos completos estao no diagrama 01.
'  Cole em https://www.plantuml.com/plantuml/uml/ e exporte em SVG.
' =====================================================================

left to right direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontName Verdana
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam nodesep 35
skinparam ranksep 55
skinparam titleFontSize 22
skinparam titleFontStyle bold

skinparam entity {
  BorderColor #6B7280
  BorderThickness 1
  FontSize 13
  FontStyle bold
  FontColor #1F2937
  AttributeFontSize 11
  AttributeFontColor #4B5563
}

skinparam ArrowColor #5A6B85
skinparam ArrowThickness 1.1
skinparam ArrowFontSize 11
skinparam ArrowFontColor #33415C

hide circle
hide empty methods

title CromoCard — Diagrama de Relacionamentos (pe-de-galinha)

legend bottom
  |= Cor |= Modulo |= Notacao |= Leitura |
  |<#DCE7F7>    | 1. Usuarios, Perfil e Acesso | &#124;&#124;--&#124;&#124; | um para um |
  |<#DCEFE4>    | 2. Catalogo Global | &#124;&#124;--o{ | um para zero ou muitos |
  |<#EBE0F5>    | 3. Colecao do Cliente | &#124;&#124;--&#124;{ | um para um ou muitos |
  |<#FAE5D3>    | 4. Comunidade (Grupos) | &#124;o--o{ | zero-ou-um para zero ou muitos |
  |<#D9EDF2>    | 5. Chat Pessoal | <<PK>> | chave primaria |
  |<#F8DFE7>    | 6. Marketplace | <<FK>> | chave estrangeira |
  |<#FBF0D0>    | 7. Notificacoes e Favoritos | * / o | campo obrigatorio / opcional |
  |<#E6E6EA>    | 8. Moderacao e Administracao | //rotulo// | so existe rotulo quando ha mais de uma ligacao entre o mesmo par |
endlegend

' =====================================================================
' ENTIDADES  (cor de fundo = modulo)
' =====================================================================

' --- 1. Usuarios, Perfil e Acesso ------------------------------------
entity usuario #DCE7F7 {
  * id <<PK>>
}
entity perfil #DCE7F7 {
  * id <<PK>>
  * usuario_id <<FK>>
}
entity endereco #DCE7F7 {
  * id <<PK>>
  * usuario_id <<FK>>
}
entity token_recuperacao_senha #DCE7F7 {
  * id <<PK>>
  * usuario_id <<FK>>
}
entity conquista #DCE7F7 {
  * id <<PK>>
}
entity usuario_conquista #DCE7F7 {
  * usuario_id <<PK, FK>>
  * conquista_id <<PK, FK>>
}
entity assinatura #DCE7F7 {
  * id <<PK>>
  * usuario_id <<FK>>
}

' --- 2. Catalogo Global ----------------------------------------------
entity categoria #DCEFE4 {
  * id <<PK>>
  o categoria_pai_id <<FK>>
}
entity raridade #DCEFE4 {
  * id <<PK>>
}
entity idioma #DCEFE4 {
  * id <<PK>>
}
entity estado_conservacao #DCEFE4 {
  * id <<PK>>
}
entity album #DCEFE4 {
  * id <<PK>>
  o categoria_id <<FK>>
}
entity carta #DCEFE4 {
  * id <<PK>>
  o album_id <<FK>>
  o categoria_id <<FK>>
  o raridade_id <<FK>>
  o idioma_id <<FK>>
}
entity foto_carta #DCEFE4 {
  * id <<PK>>
  * carta_id <<FK>>
}
entity historico_preco #DCEFE4 {
  * id <<PK>>
  * carta_id <<FK>>
}

' --- 3. Colecao do Cliente -------------------------------------------
entity colecao #EBE0F5 {
  * id <<PK>>
  * usuario_id <<FK>>
}
entity album_usuario #EBE0F5 {
  * id <<PK>>
  * colecao_id <<FK>>
  * album_id <<FK>>
}
entity colecao_carta #EBE0F5 {
  * id <<PK>>
  * colecao_id <<FK>>
  * carta_id <<FK>>
}

' --- 4. Comunidade (Grupos) ------------------------------------------
entity grupo #FAE5D3 {
  * id <<PK>>
  * criador_id <<FK>>
}
entity membro_grupo #FAE5D3 {
  * id <<PK>>
  * grupo_id <<FK>>
  * usuario_id <<FK>>
}
entity solicitacao_grupo #FAE5D3 {
  * id <<PK>>
  * grupo_id <<FK>>
  * usuario_id <<FK>>
  o avaliado_por_id <<FK>>
}
entity mensagem_grupo #FAE5D3 {
  * id <<PK>>
  * grupo_id <<FK>>
  * autor_id <<FK>>
  o mensagem_respondida_id <<FK>>
  o carta_id <<FK>>
  o anuncio_id <<FK>>
}
entity enquete #FAE5D3 {
  * id <<PK>>
  * mensagem_grupo_id <<FK>>
}
entity opcao_enquete #FAE5D3 {
  * id <<PK>>
  * enquete_id <<FK>>
}
entity voto_enquete #FAE5D3 {
  * opcao_enquete_id <<PK, FK>>
  * usuario_id <<PK, FK>>
}

' --- 5. Chat Pessoal --------------------------------------------------
entity conversa #D9EDF2 {
  * id <<PK>>
  o anuncio_id <<FK>>
}
entity participante_conversa #D9EDF2 {
  * conversa_id <<PK, FK>>
  * usuario_id <<PK, FK>>
}
entity mensagem #D9EDF2 {
  * id <<PK>>
  * conversa_id <<FK>>
  * autor_id <<FK>>
  o mensagem_respondida_id <<FK>>
}
entity bloqueio_usuario #D9EDF2 {
  * id <<PK>>
  * bloqueador_id <<FK>>
  * bloqueado_id <<FK>>
}

' --- 6. Marketplace ---------------------------------------------------
entity anuncio #F8DFE7 {
  * id <<PK>>
  * vendedor_id <<FK>>
  * carta_id <<FK>>
  o estado_conservacao_id <<FK>>
}
entity foto_anuncio #F8DFE7 {
  * id <<PK>>
  * anuncio_id <<FK>>
}
entity proposta #F8DFE7 {
  * id <<PK>>
  * anuncio_id <<FK>>
  * comprador_id <<FK>>
}
entity pedido #F8DFE7 {
  * id <<PK>>
  * anuncio_id <<FK>>
  * comprador_id <<FK>>
  * vendedor_id <<FK>>
  * endereco_entrega_id <<FK>>
}
entity pagamento #F8DFE7 {
  * id <<PK>>
  * pedido_id <<FK>>
}
entity avaliacao #F8DFE7 {
  * id <<PK>>
  * pedido_id <<FK>>
  * autor_id <<FK>>
  * vendedor_id <<FK>>
}

' --- 7. Notificacoes e Favoritos --------------------------------------
entity favorito #FBF0D0 {
  * id <<PK>>
  * usuario_id <<FK>>
  o album_id <<FK>>
  o carta_id <<FK>>
  o grupo_id <<FK>>
}
entity alerta_preco #FBF0D0 {
  * id <<PK>>
  * usuario_id <<FK>>
  * carta_id <<FK>>
}
entity notificacao_global #FBF0D0 {
  * id <<PK>>
  * admin_id <<FK>>
}
entity notificacao #FBF0D0 {
  * id <<PK>>
  * usuario_id <<FK>>
  o notificacao_global_id <<FK>>
}

' --- 8. Moderacao e Administracao -------------------------------------
entity denuncia #E6E6EA {
  * id <<PK>>
  * denunciante_id <<FK>>
  o moderador_id <<FK>>
  o anuncio_id <<FK>>
  o usuario_alvo_id <<FK>>
  o mensagem_grupo_id <<FK>>
}
entity solicitacao_cadastro #E6E6EA {
  * id <<PK>>
  * solicitante_id <<FK>>
  o avaliado_por_id <<FK>>
  o carta_id <<FK>>
  o album_id <<FK>>
}
entity log_auditoria #E6E6EA {
  * id <<PK>>
  * admin_id <<FK>>
}
entity configuracao_global #E6E6EA {
  * id <<PK>>
  o atualizado_por_id <<FK>>
}

' =====================================================================
' RELACIONAMENTOS
' Rotulo somente quando existe MAIS DE UMA ligacao entre o mesmo par
' de entidades (ou auto-relacionamento) - nos demais casos o nome da
' FK ja identifica a ligacao e o rotulo so poluiria o desenho.
' =====================================================================

' --- 1. Usuarios, Perfil e Acesso ------------------------------------
usuario   ||--|| perfil
usuario   ||--o{ endereco
usuario   ||--o{ token_recuperacao_senha
usuario   ||--o{ usuario_conquista
conquista ||--o{ usuario_conquista
usuario   ||--o{ assinatura

' --- 2. Catalogo Global ----------------------------------------------
categoria |o--o{ categoria : pai
categoria ||--o{ album
categoria ||--o{ carta
raridade  ||--o{ carta
idioma    ||--o{ carta
album     ||--o{ carta
carta     ||--o{ foto_carta
carta     ||--o{ historico_preco

' --- 3. Colecao do Cliente -------------------------------------------
usuario ||--|| colecao
colecao ||--o{ album_usuario
album   ||--o{ album_usuario
colecao ||--o{ colecao_carta
carta   ||--o{ colecao_carta

' --- 4. Comunidade (Grupos) ------------------------------------------
usuario        ||--o{ grupo             : criador
grupo          ||--|{ membro_grupo
usuario        ||--o{ membro_grupo
grupo          ||--o{ solicitacao_grupo
usuario        ||--o{ solicitacao_grupo : solicitante
usuario        |o--o{ solicitacao_grupo : avaliador
grupo          ||--o{ mensagem_grupo
usuario        ||--o{ mensagem_grupo    : autor
mensagem_grupo |o--o{ mensagem_grupo    : resposta
carta          |o--o{ mensagem_grupo
anuncio        |o--o{ mensagem_grupo
mensagem_grupo ||--|| enquete
enquete        ||--|{ opcao_enquete
opcao_enquete  ||--o{ voto_enquete
usuario        ||--o{ voto_enquete

' --- 5. Chat Pessoal --------------------------------------------------
conversa ||--|{ participante_conversa
usuario  ||--o{ participante_conversa
conversa ||--o{ mensagem
usuario  ||--o{ mensagem         : autor
mensagem |o--o{ mensagem         : resposta
anuncio  |o--o{ conversa
usuario  ||--o{ bloqueio_usuario : bloqueador
usuario  ||--o{ bloqueio_usuario : bloqueado

' --- 6. Marketplace ---------------------------------------------------
usuario            ||--o{ anuncio   : vendedor
carta              ||--o{ anuncio
estado_conservacao |o--o{ anuncio
anuncio            ||--o{ foto_anuncio
anuncio            ||--o{ proposta
usuario            ||--o{ proposta  : comprador
anuncio            ||--o{ pedido
usuario            ||--o{ pedido    : comprador
usuario            ||--o{ pedido    : vendedor
endereco           ||--o{ pedido
pedido             ||--|| pagamento
pedido             ||--|| avaliacao
usuario            ||--o{ avaliacao : autor
usuario            ||--o{ avaliacao : avaliado

' --- 7. Notificacoes e Favoritos --------------------------------------
usuario            ||--o{ favorito
album              |o--o{ favorito
carta              |o--o{ favorito
grupo              |o--o{ favorito
usuario            ||--o{ alerta_preco
carta              ||--o{ alerta_preco
usuario            ||--o{ notificacao
notificacao_global |o--o{ notificacao
usuario            ||--o{ notificacao_global : admin

' --- 8. Moderacao e Administracao -------------------------------------
usuario        ||--o{ denuncia             : denunciante
usuario        |o--o{ denuncia             : moderador
usuario        |o--o{ denuncia             : alvo
anuncio        |o--o{ denuncia
mensagem_grupo |o--o{ denuncia
usuario        ||--o{ solicitacao_cadastro : solicitante
usuario        |o--o{ solicitacao_cadastro : avaliador
carta          |o--o{ solicitacao_cadastro
album          |o--o{ solicitacao_cadastro
usuario        ||--o{ log_auditoria        : admin
usuario        |o--o{ configuracao_global  : admin

@enduml
