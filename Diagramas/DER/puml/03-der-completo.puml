colecao ||--o{ album_usuario : acompanha
album   ||--o{ album_usuario : acompanhado em
colecao ||--o{ colecao_carta : registra
carta   ||--o{ colecao_carta : aparece em

' --- 4. Comunidade (Grupos) -------------------------------------------
usuario        ||--o{ grupo             : cria
grupo          ||--|{ membro_grupo      : tem
usuario        ||--o{ membro_grupo      : participa
grupo          ||--o{ solicitacao_grupo : recebe
usuario        ||--o{ solicitacao_grupo : envia
usuario        |o--o{ solicitacao_grupo : avalia
grupo          ||--o{ mensagem_grupo    : hospeda
usuario        ||--o{ mensagem_grupo    : publica
mensagem_grupo |o--o{ mensagem_grupo    : responde
carta          |o--o{ mensagem_grupo    : compartilhada
anuncio        |o--o{ mensagem_grupo    : compartilhado
mensagem_grupo ||--|| enquete           : contem
enquete        ||--|{ opcao_enquete     : oferece
opcao_enquete  ||--o{ voto_enquete      : recebe
usuario        ||--o{ voto_enquete      : vota

' --- 5. Chat Pessoal ---------------------------------------------------
conversa ||--|{ participante_conversa : reune
usuario  ||--o{ participante_conversa : participa
conversa ||--o{ mensagem              : contem
usuario  ||--o{ mensagem              : envia
mensagem |o--o{ mensagem              : responde
anuncio  |o--o{ conversa              : origina
usuario  ||--o{ bloqueio_usuario      : bloqueia
usuario  ||--o{ bloqueio_usuario      : e bloqueado

' --- 6. Marketplace ----------------------------------------------------
usuario            ||--o{ anuncio      : anuncia
carta              ||--o{ anuncio      : ofertada em
estado_conservacao |o--o{ anuncio      : descreve
anuncio            ||--o{ foto_anuncio : exibe
anuncio            ||--o{ proposta     : recebe
usuario            ||--o{ proposta     : propoe
anuncio            ||--o{ pedido       : gera
usuario            ||--o{ pedido       : compra
usuario            ||--o{ pedido       : vende
endereco           ||--o{ pedido       : entregue em
pedido             ||--|| pagamento    : quitado por
pedido             ||--|| avaliacao    : avaliado por
usuario            ||--o{ avaliacao    : escreve
usuario            ||--o{ avaliacao    : recebe

' --- 7. Notificacoes e Favoritos ---------------------------------------
usuario            ||--o{ favorito           : favorita
album              |o--o{ favorito           : alvo
carta              |o--o{ favorito           : alvo
grupo              |o--o{ favorito           : alvo
usuario            ||--o{ alerta_preco       : configura
carta              ||--o{ alerta_preco       : monitorada
usuario            ||--o{ notificacao        : recebe
notificacao_global |o--o{ notificacao        : expande em
usuario            ||--o{ notificacao_global : dispara

' --- 8. Moderacao e Administracao --------------------------------------
usuario        ||--o{ denuncia             : denuncia
usuario        |o--o{ denuncia             : modera
anuncio        |o--o{ denuncia             : alvo
usuario        |o--o{ denuncia             : alvo
mensagem_grupo |o--o{ denuncia             : alvo
usuario        ||--o{ solicitacao_cadastro : solicita
usuario        |o--o{ solicitacao_cadastro : aprova
carta          |o--o{ solicitacao_cadastro : resulta em
album          |o--o{ solicitacao_cadastro : resulta em
usuario        ||--o{ log_auditoria        : produz
usuario        |o--o{ configuracao_global  : atualiza

@enduml
